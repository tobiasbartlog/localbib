{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin-manifest/1",
  "title": "LocalBib Plugin Manifest",
  "description": "Identity of a LocalBib plugin. Mirrors plugin_api.PluginManifest (Architektur Abschn. 5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "min_api_version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable plugin id, e.g. \"notes\"."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "min_api_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
