{
  "id": "hello",
  "name": "Hello",
  "version": "0.1.0",
  "author": "LocalBib",
  "license": "MIT",
  "homepage": "https://example.org/hello",
  "tagline": "A minimal fixture Add-on for the Add-on Contract tests.",
  "description": "Greets an Item's authors. Exists only to exercise the **Add-on Contract**: manifest, Python package, frontend and locales.",
  "languages": ["en", "de"],
  "default_language": "en",
  "api_version": 2,
  "min_core": "0.8.0",
  "python": "any",
  "permissions": ["library.read", "llm", "settings.core", "storage"],
  "settings": [
    {"key": "salutation", "type": "string", "label": "hello.settings.salutation", "default": ""},
    {"key": "api_key", "type": "secret", "label": "hello.settings.api_key"},
    {"key": "greetings_folder", "type": "path", "label": "hello.settings.greetings_folder", "default": ""},
    {"key": "shout", "type": "bool", "label": "hello.settings.shout", "default": false}
  ],
  "frontend": {
    "script": "frontend/hello.js",
    "stylesheet": "frontend/hello.css",
    "locales": {
      "en": "frontend/locales/en.json",
      "de": "frontend/locales/de.json"
    }
  },
  "nav": {
    "label": "hello.nav.label",
    "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>",
    "route": "/hello",
    "view": "hello.main"
  },
  "slots": ["item-list-filter", "item-detail-aside", "research-chat-context", "settings"]
}
