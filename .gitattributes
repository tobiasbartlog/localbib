# Fixture PDFs are byte-exact. They are small and hand-written, so they contain
# no NUL byte and git's heuristic would call them text and rewrite their line
# endings on checkout — which moves every xref offset and changes the SHA256 the
# migration tests assert. Never convert them.
tests/fixtures/**/*.pdf -text

# Vendored third-party files (PDF.js, #229) stay byte-identical to the pinned
# upstream release, so their hashes can always be checked against it.
static/vendor/** -text
