# Schichtgrenzen des Kerns. Pruefen:  lint-imports
#
# Hinweis zum Stack: Der Kern besteht aus flachen Einzeldatei-Modulen
# (webapp.py, literature_manager.py, ...). grimp kann nur Pakete (Verzeichnis
# mit __init__.py) als root_packages bauen, daher sind hier nur `plugin_api`,
# `services` und `routers` die Wurzeln; die Kernmodule werden via
# `include_external_packages` als externe Importziele erfasst.
#
# P3 — "Eine Grenze, ein Vertrag" (ein Add-on importiert ausschliesslich aus
# plugin_api, nie aus dem Kern): jedes Add-on-Bundle bringt diesen Vertrag als
# eigene `.importlinter` in seinem Bundle-Ordner mit und wird dort geprueft
# (ADR-0021). Die Gegenrichtung (Kern importiert nie aus einem Add-on) ist
# strukturell garantiert: der Kern laedt Add-ons ausschliesslich per
# importlib-String in plugin_loader.py/registry.py.
[importlinter]
root_packages =
    plugin_api
    services
    routers
include_external_packages = True


# Backend-Modularisierung (#71/#73): Schichtgrenzen fuer das neue Skelett.
# services/ ist transport-frei — Domaenenlogik, kein HTTP-/Routing-Bezug; es darf
# daher weder aus routers/ noch aus webapp importieren. Greift trivial, solange
# die Pakete leer sind, und wird bindend, sobald Logik einzieht.
[importlinter:contract:services-no-transport]
name = services importiert nie aus routers oder webapp
type = forbidden
source_modules =
    services
forbidden_modules =
    routers
    webapp

# routers/ buendeln HTTP-Endpunkte; ein Router darf keinen anderen Router
# importieren (geteilte Logik gehoert nach services/). Als Independence-Contract
# modelliert (ein Forbidden-Contract mit identischer Quelle/Ziel ist in
# import-linter nicht zulaessig -> "shared descendants"). Greift trivial, solange
# das Paket leer ist; jedes neue Router-Submodul (z. B. routers.papers) wird hier
# eingetragen, damit die Geschwister-Unabhaengigkeit bindend bleibt.
[importlinter:contract:routers-independent]
name = Ein Router importiert nie aus einem anderen Router
type = independence
modules =
    routers.stats
    routers.version
    routers.banner
    routers.license
    routers.appearance
    routers.settings
    routers.categories
    routers.export
    routers.custom_fields
    routers.bibtex_import
    routers.paper_by_doi
    routers.papers
    routers.validate
    routers.references
    routers.research_chat
    routers.analysis
    routers.import
    routers.duplicates
    routers.maintenance
    routers.search
    routers.llm
    routers.migration
    routers.plugins
    routers.marketplace
