# =============================================================================
# LITERATUR-MANAGER - KONFIGURATION
# =============================================================================

# =============================================================================
# LLM-ANBIETER (alle OpenAI-kompatibel)
# =============================================================================
# Die LLM-Konfiguration steht NICHT mehr in dieser Datei, sondern in llm.json
# daneben: beliebig viele benannte Verbindungen (Anbieter + Basis-URL + Key,
# Key optional fuer Ollama & Co.) und drei Rollen - Reasoning, Simple,
# Embedding - je an eine Verbindung + Modell gebunden. Gepflegt wird sie in der
# App unter Einstellungen -> LLM (das Onboarding legt die erste Verbindung an).
#
# Eine alte .env mit LLM_PROVIDER / LLM_API_KEY / LLM_MODEL / LLM_MODEL_FAST /
# LLM_EMBED_MODEL / LLM_EMBED_URL wird beim Start lesend uebernommen (eine
# Verbindung "default"); beim ersten Speichern im LLM-Tab verschwinden diese
# Keys hier. Neu anlegen sollte man sie nicht.
#
# Ablageort von llm.json ueberschreiben (Default: neben dieser Datei):
# LLM_CONFIG_PATH=

# CrossRef/OpenAlex - DEINE Email fuer hoeflichen API-Zugriff (optional, aber
# empfohlen: bessere Rate-Limits). Leer lassen -> es wird keine Adresse
# mitgeschickt.
CROSSREF_MAILTO=

# Optionaler OpenAlex Premium-API-Key (openalex.org). Hebt das Rate-Limit an
# (Premium-Pool statt Polite-Pool). Nur einfuegen, wenn zusaetzliches Budget
# gebraucht wird. Leer lassen -> Polite-Pool.
OPENALEX_API_KEY=

# Watchdog Check-Intervall in Sekunden
WATCH_INTERVAL=5

# Maximale Seiten für OCR/Text-Extraktion
MAX_OCR_PAGES=math.inf

# =============================================================================
# ADD-ONS
# =============================================================================
# Dev-Suchpfade: Ordner, die der Kern wie ein installiertes Add-on-Bundle laedt
# (plugin.json oben im Ordner). Mehrere mit ; (Windows) bzw. : trennen. Leer ->
# nur die installierten Bundles unter %LOCALAPPDATA%\LocalBib\plugins.
LOCALBIB_PLUGIN_DEV_PATHS=


# =============================================================================
# OBERFLAECHE
# =============================================================================
# Sprache der Oberflaeche: en | de (ADR-0018). Englisch ist die Quellsprache
# und der Default; Deutsch ist eine vollstaendige Uebersetzung davon. Beim
# ersten Start schlaegt das Onboarding die Sprache aus dem Browser vor, und
# umschalten laesst sie sich jederzeit unter Einstellungen -> Erscheinungsbild.
# Bereits erzeugte Inhalte (Zusammenfassungen, Kategorien) behalten die
# Sprache, in der sie entstanden sind - hier wird nichts nachtraeglich
# uebersetzt.
UI_LANGUAGE=en

# =============================================================================
# LIZENZ (Polar, ADR-0015)
# =============================================================================
# Nichts davon ist noetig: die ausgelieferte App kennt Organisation und
# Checkout-URL des LocalBib-Stores bereits (oeffentliche Kennungen, keine
# Secrets). Diese Variablen sind nur zum Umbiegen da, z.B. auf die
# Polar-Sandbox waehrend der Entwicklung:
#   POLAR_API_BASE=https://sandbox-api.polar.sh
#   POLAR_ORGANIZATION_ID=<Sandbox-Org-ID>
#   POLAR_CHECKOUT_URL=<Sandbox-Checkout-Link>
