# =============================================================================
# LITERATUR-MANAGER - KONFIGURATION
# =============================================================================

# =============================================================================
# LLM-ANBIETER (alle OpenAI-kompatibel)
# =============================================================================
# Anbieter-Preset: openai | openrouter | groq | deepseek | mistral | kiconnect | custom
# Leer lassen -> keine LLM-Features (die App laeuft, das Onboarding fragt danach).
LLM_PROVIDER=

# API-Key des gewaehlten Anbieters:
#   kiconnect  -> https://chat.kiconnect.nrw/
#   openai     -> https://platform.openai.com/api-keys
#   openrouter -> https://openrouter.ai/keys   (ein Key, viele Modelle)
#   groq       -> https://console.groq.com/keys
#   deepseek   -> https://platform.deepseek.com/api_keys
#   mistral    -> https://console.mistral.ai/api-keys
LLM_API_KEY=

# Nur fuer LLM_PROVIDER=custom (oder zum Ueberschreiben der Preset-URL):
# Basis-URL OHNE /chat/completions, z.B. http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=

# Modellname fuer Denkaufgaben (Chat, Analyse) - provider-abhaengig, z.B.
# gpt-4o (OpenAI), openai/gpt-4o (OpenRouter), llama-3.3-70b-versatile (Groq),
# gpt-5.5 (KI Connect). Leer lassen -> das Onboarding schlaegt Modelle vor.
LLM_MODEL=

# Modellname fuer einfache Tasks (Extraktion, Kategorisierung, Metadaten).
# Leer lassen -> Fallback auf LLM_MODEL. Ein schnelles/guenstiges Modell spart
# Zeit & Kosten, z.B. gpt-4o-mini, llama-3.1-8b-instant (Groq).
LLM_MODEL_FAST=

# Veraltet: wird weiterhin als Fallback fuer LLM_API_KEY akzeptiert
KICONNECT_API_KEY=

# Embedding-Modell fuer semantische Suche/Clustering (leer lassen -> keine
# Embeddings, App faellt auf lexikalische Verfahren zurueck), z.B.
# text-embedding-3-small (OpenAI), nomic-embed-text (Ollama) oder
# qwen3-embedding-8b (KI Connect).
LLM_EMBED_MODEL=

# Optionaler Override der Embeddings-URL (sonst von LLM_BASE_URL/KI-Connect
# abgeleitet: /chat/completions -> /embeddings). Fuer Anbieter ohne
# KI-Connect-Zugriff, z.B. Ollama: http://localhost:11434/v1/embeddings
LLM_EMBED_URL=

# CrossRef/OpenAlex - DEINE Email fuer hoeflichen API-Zugriff (optional, aber
# empfohlen: bessere Rate-Limits). Leer lassen -> es wird keine Adresse
# mitgeschickt.
CROSSREF_MAILTO=

# Optionaler OpenAlex Premium-API-Key (openalex.org). Hebt das Rate-Limit an
# (Premium-Pool statt Polite-Pool). Nur einfuegen, wenn zusaetzliches Budget
# gebraucht wird. Leer lassen -> Polite-Pool.
OPENALEX_API_KEY=

# Watchdog Check-Intervall in Sekunden
WATCH_INTERVAL=5

# Maximale Seiten für OCR/Text-Extraktion
MAX_OCR_PAGES=math.inf


# =============================================================================
# LIZENZ (Polar, ADR-0015)
# =============================================================================
# Nichts davon ist noetig: die ausgelieferte App kennt Organisation und
# Checkout-URL des LocalBib-Stores bereits (oeffentliche Kennungen, keine
# Secrets). Diese Variablen sind nur zum Umbiegen da, z.B. auf die
# Polar-Sandbox waehrend der Entwicklung:
#   POLAR_API_BASE=https://sandbox-api.polar.sh
#   POLAR_ORGANIZATION_ID=<Sandbox-Org-ID>
#   POLAR_CHECKOUT_URL=<Sandbox-Checkout-Link>
